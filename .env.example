# Sigma runtime variable NAMES only. Never commit secret values.

# Live model provider. The endpoint may be a hosted provider or trusted self-hosted
# service implementing Responses or chat-completions JSON shapes.
SIGMA_RUNTIME_PROVIDER=http
SIGMA_LLM_ENDPOINT=
SIGMA_LLM_MODEL=
SIGMA_LLM_PROTOCOL=responses
SIGMA_LLM_API_KEY=
SIGMA_LLM_TIMEOUT_SECONDS=300
SIGMA_LLM_MAX_TOKENS=768
SIGMA_LLM_CONTEXT_TOKENS=4096
SIGMA_LLM_DISABLE_THINKING=1
SIGMA_MAX_PARALLEL_SPECIALISTS=1
SIGMA_LIVE_PROBE_TIMEOUT_SECONDS=600

# Runtime persistence and API.
SIGMA_RUNTIME_DB=runtime-data/sigma-runtime.db
SIGMA_RUNTIME_HOST=127.0.0.1
SIGMA_RUNTIME_PORT=8080
SIGMA_RUNTIME_TOKEN=
SIGMA_RUNTIME_HTTP_LOG=0

# CI/test only. Never enable this to represent real intelligence.
SIGMA_ALLOW_TEST_PROVIDER=0
# Autonomous portfolio runner. Read-only by default.
SIGMA_GITHUB_TOKEN=
SIGMA_RUNNER_ALLOW_WRITE=0
SIGMA_RUNNER_EXECUTE=0
SIGMA_RUNNER_INTERVAL_SECONDS=900
SIGMA_WORKER_ENDPOINT=
SIGMA_WORKER_TOKEN=
SIGMA_WORKER_TIMEOUT_SECONDS=900
# Governed long-term memory. Disabled by default.
SIGMA_MEMORY_PROVIDER=none
SIGMA_MEMORY_ENDPOINT=
SIGMA_MEMORY_TOKEN=
SIGMA_MEMORY_TIMEOUT_SECONDS=120
