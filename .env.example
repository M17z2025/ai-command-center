# Sigma runtime variable NAMES only. Never commit secret values.

# Live model provider. The endpoint may be a hosted provider or trusted self-hosted
# service implementing Responses or chat-completions JSON shapes.
SIGMA_RUNTIME_PROVIDER=http
SIGMA_LLM_ENDPOINT=
SIGMA_LLM_MODEL=
SIGMA_LLM_PROTOCOL=responses
SIGMA_LLM_API_KEY=
SIGMA_LLM_TIMEOUT_SECONDS=120

# Runtime persistence and API.
SIGMA_RUNTIME_DB=runtime-data/sigma-runtime.db
SIGMA_RUNTIME_HOST=127.0.0.1
SIGMA_RUNTIME_PORT=8080
SIGMA_RUNTIME_TOKEN=
SIGMA_RUNTIME_HTTP_LOG=0

# CI/test only. Never enable this to represent real intelligence.
SIGMA_ALLOW_TEST_PROVIDER=0
