# OpenHands worker settings for Sigma.
# Copy values into deploy/sigma-stack/.env on the VPS. Do not commit secrets.

# Pinned current Agent Canvas image. Upgrade deliberately after verification.
OPENHANDS_IMAGE=ghcr.io/openhands/agent-canvas:1.24.0

# Loopback-only listener. Reach it through SSH tunnel or a protected reverse proxy.
OPENHANDS_PORT=8000

# Persistent state and project workspaces on the OVH host.
OPENHANDS_STATE_DIR=/opt/sigma/openhands/state
OPENHANDS_PROJECTS_DIR=/opt/sigma/openhands/projects
