# Copy to .env on the private runtime host only. Never commit the populated file.

SIGMA_RUNTIME_PORT=8080
SIGMA_RUNTIME_TOKEN=

SIGMA_RUNTIME_PROVIDER=http
SIGMA_LLM_ENDPOINT=
SIGMA_LLM_MODEL=
SIGMA_LLM_PROTOCOL=chat-completions
SIGMA_LLM_API_KEY=
SIGMA_LLM_TIMEOUT_SECONDS=300
SIGMA_LLM_MAX_TOKENS=768
SIGMA_LLM_CONTEXT_TOKENS=4096
SIGMA_LLM_DISABLE_THINKING=1
SIGMA_MAX_PARALLEL_SPECIALISTS=1
SIGMA_LIVE_PROBE_TIMEOUT_SECONDS=600

# FreeLLMAPI development-pilot overlay only.
FREELLMAPI_ENCRYPTION_KEY=
FREELLMAPI_UNIFIED_KEY=
FREEAPI_CONFIG_JSON=
# Self-hosted Ollama overlay. Choose a model appropriate for the private host.
OLLAMA_MODEL=

# Autonomous portfolio runner. Keep write/execute off until worker/security gates pass.
SIGMA_GITHUB_TOKEN=
SIGMA_RUNNER_ALLOW_WRITE=0
SIGMA_RUNNER_EXECUTE=0
SIGMA_RUNNER_INTERVAL_SECONDS=60
SIGMA_RUNNER_LEASE_TTL_SECONDS=1800
SIGMA_RUNNER_STALE_AFTER_SECONDS=1800
SIGMA_RUNNER_CI_POLL_SECONDS=10
SIGMA_RUNNER_CI_TIMEOUT_SECONDS=900
SIGMA_RUNNER_MAX_REPAIRS=2
SIGMA_WORKER_ENDPOINT=
SIGMA_WORKER_TOKEN=
SIGMA_WORKER_TIMEOUT_SECONDS=900
SIGMA_WORKER_ALLOW_WRITE=0
SIGMA_WORKER_ALLOWED_REPOSITORIES=M17z2025/ai-command-center,M17z2025/mi7z-web,M17z2025/alisha-ai-platform,M17z2025/invoiceit-by-mi7z,M17z2025/lycia-zambia,M17z2025/umarketit,M17z2025/total-mining-intelligence,M17z2025/mybodyfit,M17z2025/tattooit,M17z2025/legalit,M17z2025/signit-by-mi7z,M17z2025/ihumanit,M17z2025/designit-ai-platform,M17z2025/synergy-ai-pay,M17z2025/lycia-limited
SIGMA_WORKER_MODEL_TIMEOUT_SECONDS=900
SIGMA_WORKER_VERIFY_TIMEOUT_SECONDS=900
SIGMA_WORKER_KEEP_WORKSPACE=0
OLLAMA_WORKER_MODEL=qwen2.5:7b
# Graphiti/FalkorDB memory overlay.
SIGMA_MEMORY_TOKEN=
SIGMA_MEMORY_TIMEOUT_SECONDS=120
SIGMA_MEMORY_STRUCTURED_OUTPUT_MODE=json_object
OLLAMA_EMBEDDING_MODEL=
SIGMA_MEMORY_EMBEDDING_DIM=1024
