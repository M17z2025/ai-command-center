# Copy to .env on the private runtime host only. Never commit the populated file.

SIGMA_RUNTIME_PORT=8080
SIGMA_RUNTIME_TOKEN=

SIGMA_RUNTIME_PROVIDER=http
SIGMA_LLM_ENDPOINT=
SIGMA_LLM_MODEL=
SIGMA_LLM_PROTOCOL=chat-completions
SIGMA_LLM_API_KEY=
SIGMA_LLM_TIMEOUT_SECONDS=120

# FreeLLMAPI development-pilot overlay only.
FREELLMAPI_ENCRYPTION_KEY=
FREELLMAPI_UNIFIED_KEY=
FREEAPI_CONFIG_JSON=
# Self-hosted Ollama overlay. Choose a model appropriate for the private host.
OLLAMA_MODEL=

# Autonomous portfolio runner. Keep write/execute off until worker/security gates pass.
SIGMA_GITHUB_TOKEN=
SIGMA_RUNNER_ALLOW_WRITE=0
SIGMA_RUNNER_EXECUTE=0
SIGMA_RUNNER_INTERVAL_SECONDS=900
SIGMA_WORKER_ENDPOINT=
SIGMA_WORKER_TOKEN=
SIGMA_WORKER_TIMEOUT_SECONDS=900
