{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigma.mi7z.local/schemas/sigma-expert.schema.json",
  "title": "Sigma Expert Definition",
  "type": "object",
  "required": ["schema_version", "expert"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "expert": {
      "type": "object",
      "required": ["id", "name", "version", "status", "parent", "mission", "domain_scope", "allowed_tools", "prohibited_actions", "evidence_requirements", "team_creation", "evaluation", "expiry_or_review_condition"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["REGISTERED", "CANDIDATE", "EVALUATED", "PROMOTED", "REJECTED", "RUNTIME_VERIFIED"]},
        "parent": {"type": "string", "minLength": 1},
        "mission": {"type": "string", "minLength": 1},
        "domain_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cognitive_methods": {"type": "array", "items": {"type": "string"}},
        "allowed_tools": {"type": "array", "items": {"type": "string"}},
        "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "team_creation": {
          "type": "object",
          "required": ["allowed", "max_depth"],
          "properties": {
            "allowed": {"type": "boolean"},
            "max_depth": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "evaluation": {
          "type": "object",
          "required": ["benchmark_suite", "independent_evaluator"],
          "properties": {
            "benchmark_suite": {"type": "string", "minLength": 1},
            "independent_evaluator": {"type": "boolean", "const": true}
          },
          "additionalProperties": true
        },
        "expiry_or_review_condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}