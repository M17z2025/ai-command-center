FROM python:3.12-slim

WORKDIR /app
COPY requirements-control.txt ./
RUN pip install --no-cache-dir -r requirements-control.txt
COPY . .

ENV PYTHONUNBUFFERED=1
EXPOSE 8080

CMD ["sh", "-c", "python scripts/sigma_mesh_runtime.py --db ${SIGMA_RUNTIME_DB:-/data/sigma-runtime.db} serve --host 0.0.0.0 --port ${PORT:-8080}"]
