FROM python:3.12-slim

WORKDIR /app
COPY requirements-memory.txt ./
RUN pip install --no-cache-dir -r requirements-memory.txt
COPY scripts/sigma_graphiti_memory_service.py ./scripts/sigma_graphiti_memory_service.py

ENV PYTHONUNBUFFERED=1
EXPOSE 8090

CMD ["python", "scripts/sigma_graphiti_memory_service.py"]
