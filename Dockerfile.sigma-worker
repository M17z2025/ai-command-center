FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       git \
       bash \
       ca-certificates \
       curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY scripts/sigma_openhands_worker_service.py ./scripts/sigma_openhands_worker_service.py

RUN useradd --create-home --uid 10001 sigmaworker \
    && mkdir -p /workspaces \
    && chown -R sigmaworker:sigmaworker /app /workspaces

USER sigmaworker

ENV PYTHONUNBUFFERED=1
ENV CI=1
EXPOSE 8091

CMD ["python", "scripts/sigma_openhands_worker_service.py"]
